<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<BorderPane prefWidth="700" prefHeight="500" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.logicgate.ui.OptionsController" styleClass="options-root">
    <stylesheets>
        <URL value="@main.css" />
        <URL value="@options.css" />
    </stylesheets>
    
    <left>
        <VBox fx:id="sidebar" styleClass="options-sidebar">
            <Label text="%options.title" styleClass="options-header"/>
            <Region prefHeight="10"/>
            <ListView fx:id="categoryList" styleClass="options-category-list" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>
    
    <center>
        <StackPane fx:id="contentArea" styleClass="options-content-area">
            <!-- 시뮬레이션 설정 -->
            <VBox fx:id="simPane" spacing="20" styleClass="options-pane">
                <Label text="%options.sim" styleClass="options-title"/>
                <Separator styleClass="options-separator"/>
                <Label text="%options.sim.desc" styleClass="options-desc"/>
                
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="%options.sim.speed" styleClass="options-label"/>
                    <TextField fx:id="tickFreqField" prefWidth="100" promptText="%options.sim.speed_prompt" styleClass="options-textfield"/>
                </HBox>
                <Label text="%options.sim.speed_hint" styleClass="options-hint"/>
            </VBox>
            
            <!-- 에디터 & 그리드 설정 -->
            <VBox fx:id="gridPane" spacing="20" styleClass="options-pane" visible="false">
                <Label text="%options.grid" styleClass="options-title"/>
                <Separator styleClass="options-separator"/>
                <Label text="%options.grid.desc" styleClass="options-desc"/>
                
                <CheckBox fx:id="showGridCheck" text="%options.grid.show" styleClass="options-checkbox"/>
                <CheckBox fx:id="snapToGridCheck" text="%options.grid.snap" styleClass="options-checkbox"/>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="%options.grid.size" styleClass="options-label"/>
                    <Spinner fx:id="gridSizeSpinner" prefWidth="100" styleClass="options-spinner"/>
                </HBox>
                <CheckBox fx:id="showAlignGuidesCheck" text="%options.grid.align_guides" styleClass="options-checkbox"/>
            </VBox>
            
            <!-- 시각적 설정 -->
            <VBox fx:id="visualPane" spacing="20" styleClass="options-pane" visible="false">
                <Label text="%options.visual" styleClass="options-title"/>
                <Separator styleClass="options-separator"/>
                <Label text="%options.visual.desc" styleClass="options-desc"/>
                
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="%options.visual.wire_style" styleClass="options-label"/>
                    <ComboBox fx:id="wireStyleCombo" prefWidth="150" styleClass="options-combo"/>
                </HBox>
                <CheckBox fx:id="defaultShowLabelCheck" text="%options.visual.show_label" styleClass="options-checkbox"/>
                
                <Label text="%options.visual.wire_color" styleClass="options-subtitle"/>
                <CheckBox fx:id="showWireStateCheck" text="%options.visual.wire_state" styleClass="options-checkbox"/>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="%options.visual.wire_high" styleClass="options-label-sub"/>
                    <ColorPicker fx:id="wireHighColorPicker" styleClass="options-colorpicker"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="%options.visual.wire_low" styleClass="options-label-sub"/>
                    <ColorPicker fx:id="wireLowColorPicker" styleClass="options-colorpicker"/>
                </HBox>
            </VBox>
            
            <!-- 편의성 설정 -->
            <VBox fx:id="uxPane" spacing="20" styleClass="options-pane" visible="false">
                <Label text="%options.ux" styleClass="options-title"/>
                <Separator styleClass="options-separator"/>
                <Label text="%options.ux.desc" styleClass="options-desc"/>
                
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="%options.ux.language" styleClass="options-label"/>
                    <ComboBox fx:id="languageCombo" prefWidth="150" styleClass="options-combo"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="%options.ux.autosave" styleClass="options-label"/>
                    <Spinner fx:id="autosaveSpinner" prefWidth="90" styleClass="options-spinner"/>
                    <Label text="%options.ux.autosave_hint" styleClass="options-hint"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="%options.ux.zoom_sens" styleClass="options-label"/>
                    <Slider fx:id="zoomSensSlider" min="1.01" max="2.0" prefWidth="200" showTickLabels="true" showTickMarks="true"/>
                    <Label fx:id="zoomSensLabel" text="1.10" styleClass="options-value"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>
    
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="15" styleClass="options-bottom-bar">
            <Button text="%common.cancel" onAction="#cancel" styleClass="options-btn-cancel"/>
            <Button text="%common.apply_save" onAction="#apply" defaultButton="true" styleClass="options-btn-apply"/>
        </HBox>
    </bottom>
</BorderPane>
