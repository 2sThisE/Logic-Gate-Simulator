<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.logicgate.ui.MainController">
    <stylesheets>
        <URL value="@main.css" />
    </stylesheets>
    <BorderPane>
        <top>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #202020;" onMousePressed="#clearFocusFromCanvas">
            <MenuBar fx:id="mainMenuBar" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent;">
                <Menu text="%menu.file">
                    <MenuItem text="%menu.file.new_project" onAction="#newProject"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="%menu.file.save_project" onAction="#saveProject"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="%menu.file.export_json" onAction="#exportJson"/>
                    <MenuItem text="%menu.file.import_json" onAction="#importJson"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="%menu.file.exit" onAction="#shutdown"/>
                </Menu>
                <Menu text="%menu.edit">
                    <MenuItem text="%menu.edit.clear_all" onAction="#clearCircuit"/>
                </Menu>
                <Menu text="%menu.settings">
                    <MenuItem text="%menu.settings.mod_manager" onAction="#openModManager"/>
                    <MenuItem text="%menu.settings.options" onAction="#openOptions"/>
                </Menu>
                <Menu text="%menu.help">
                    <MenuItem text="%menu.help.usage" onAction="#openHelp"/>
                </Menu>
            </MenuBar>
            <HBox alignment="CENTER" spacing="10" style="-fx-padding: 0 15 0 0;">
                <Button fx:id="btnPlayPause" text="" onAction="#toggleSimulation" styleClass="sim-btn, sim-btn-pause">
                    <graphic>
                        <FontIcon fx:id="playPauseIcon" iconLiteral="mdi2p-pause" iconSize="16" iconColor="white"/>
                    </graphic>
                </Button>
                <Button fx:id="btnReset" text="" onAction="#resetSimulation" styleClass="sim-btn, sim-btn-reset">
                    <graphic>
                        <FontIcon iconLiteral="mdi2r-reload" iconSize="16" iconColor="white"/>
                    </graphic>
                </Button>
            </HBox>
        </HBox>
        </top>
        <center>
        <SplitPane dividerPositions="0.2, 0.8">
            <items>
                <!-- 좌측 사이드바: 부품 상자 -->
                <VBox fx:id="leftSidebar" spacing="10" styleClass="sidebar" minWidth="160" maxWidth="500" onMousePressed="#clearFocusFromCanvas">
                    <padding>
                        <Insets top="20" right="10" bottom="20" left="10"/>
                    </padding>
                    
                    <Label text="%sidebar.components" styleClass="section-header"/>
                    <TreeView fx:id="componentTreeView" focusTraversable="false" VBox.vgrow="ALWAYS" />
                </VBox>
                
                <!-- 중앙: 캔버스 영역 -->
                <Pane fx:id="canvasPane" styleClass="canvas-area">
                    <Canvas fx:id="simulationCanvas" />
                </Pane>

                <!-- 우측 사이드바: 속성창 -->
                <VBox fx:id="rightSidebar" spacing="10" styleClass="sidebar" minWidth="160" maxWidth="400" onMousePressed="#clearFocusFromCanvas">
                    <padding>
                        <Insets top="20" right="10" bottom="20" left="10"/>
                    </padding>
                    
                    <Label text="%sidebar.search" styleClass="section-header"/>
                    <VBox spacing="5">
                        <TextField fx:id="searchTextField" promptText="%sidebar.search.prompt"/>
                        <ListView fx:id="searchResultsListView" prefHeight="200" visible="false" managed="false"/>
                    </VBox>
                    
                    <Separator/>
                    
                    <Label text="%sidebar.properties" styleClass="section-header"/>
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                        <VBox fx:id="propertyPane" spacing="12" styleClass="property-section"/>
                    </ScrollPane>
                </VBox>
            </items>
        </SplitPane>
        </center>
        <bottom>
        <VBox>
            <ListView fx:id="consoleListView" prefHeight="150" visible="false" managed="false" styleClass="console-list"/>
            <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="10">
                <padding>
                    <Insets top="3" right="10" bottom="3" left="10"/>
                </padding>
                <!-- 텍스트는 코드에서 설정할 수 있도록 임시 유지하거나 번들 참조 -->
                <Button fx:id="errorButton" text="%console.btn.logs" onAction="#toggleConsole" styleClass="status-btn"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="versionLabel" text="" styleClass="status-label"/>
            </HBox>
        </VBox>
        </bottom>
    </BorderPane>
    <VBox fx:id="notificationPane" spacing="8" maxWidth="360" maxHeight="-Infinity" pickOnBounds="false" visible="false" managed="false" styleClass="notification-stack" StackPane.alignment="BOTTOM_RIGHT">
        <padding>
            <Insets top="0" right="16" bottom="34" left="0"/>
        </padding>
    </VBox>
</StackPane>
