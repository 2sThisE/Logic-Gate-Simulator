<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<?import java.net.URL?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefWidth="800" prefHeight="600" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.logicgate.ui.HelpController" styleClass="options-root">
    <stylesheets>
        <URL value="@main.css" />
        <URL value="@options.css" />
    </stylesheets>
    
    <left>
        <VBox fx:id="sidebar" styleClass="options-sidebar">
            <Label text="%help.category.title" styleClass="options-header"/>
            <Region prefHeight="10"/>
            <ListView fx:id="helpCategoryList" styleClass="options-category-list" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>
    
    <center>
        <ScrollPane fx:id="helpScrollPane" fitToWidth="true" styleClass="options-content-area" hbarPolicy="NEVER">
            <StackPane fx:id="helpContentArea">
                <!-- 1. 소개 -->
                <VBox fx:id="introPane" spacing="20" styleClass="options-pane">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="%help.intro.title" styleClass="options-title"/>
                        <FontIcon iconLiteral="mdi2s-sparkles" iconSize="24" iconColor="#FFD700"/>
                    </HBox>
                    <Separator styleClass="options-separator"/>
                    <Label text="%help.intro.desc" styleClass="options-desc" wrapText="true"/>
                    
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="mdi2m-magnify" iconSize="16" iconColor="#888888"/>
                        <Label text="%help.intro.hint" styleClass="options-hint"/>
                    </HBox>
                </VBox>
                
                <!-- 2. 부품 조작 -->
                <VBox fx:id="componentPane" spacing="20" styleClass="options-pane" visible="false">
                    <Label text="%help.component.title" styleClass="options-title"/>
                    <Separator styleClass="options-separator"/>
                    
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconLiteral="mdi2p-puzzle" iconSize="18" iconColor="#4A90E2"/>
                        <Label text="%help.component.add.title" styleClass="options-subtitle"/>
                    </HBox>
                    <Label text="%help.component.add.desc1" styleClass="options-label" wrapText="true"/>
                    <Label text="%help.component.add.desc2" styleClass="options-label" wrapText="true"/>
                    
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconLiteral="mdi2r-rotate-right" iconSize="18" iconColor="#4A90E2"/>
                        <Label text="%help.component.rotate.title" styleClass="options-subtitle"/>
                    </HBox>
                    <Label text="%help.component.rotate.desc" styleClass="options-label" wrapText="true"/>
                    
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconLiteral="mdi2m-mouse" iconSize="18" iconColor="#4A90E2"/>
                        <Label text="%help.component.move.title" styleClass="options-subtitle"/>
                    </HBox>
                    <Label text="%help.component.move.desc1" styleClass="options-label" wrapText="true"/>
                    <Label text="%help.component.move.desc2" styleClass="options-label" wrapText="true"/>
                    
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconLiteral="mdi2s-select-group" iconSize="18" iconColor="#4A90E2"/>
                        <Label text="%help.component.group.title" styleClass="options-subtitle"/>
                    </HBox>
                    <Label text="%help.component.group.desc" styleClass="options-label" wrapText="true"/>
                </VBox>
                
                <!-- 3. 배선 (Wiring) -->
                <VBox fx:id="wiringPane" spacing="20" styleClass="options-pane" visible="false">
                    <Label text="%help.wiring.title" styleClass="options-title"/>
                    <Separator styleClass="options-separator"/>
                    
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconLiteral="mdi2p-power-plug" iconSize="18" iconColor="#FF3366"/>
                        <Label text="%help.wiring.connect.title" styleClass="options-subtitle"/>
                    </HBox>
                    <Label text="%help.wiring.connect.desc1" styleClass="options-label" wrapText="true"/>
                    <Label text="%help.wiring.connect.desc2" styleClass="options-label" wrapText="true"/>
                    <Label text="%help.wiring.connect.desc3" styleClass="options-label" wrapText="true"/>
                    
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconLiteral="mdi2c-content-cut" iconSize="18" iconColor="#FF3366"/>
                        <Label text="%help.wiring.disconnect.title" styleClass="options-subtitle"/>
                    </HBox>
                    <Label text="%help.wiring.disconnect.desc" styleClass="options-label" wrapText="true"/>
                    
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconLiteral="mdi2v-vector-polyline" iconSize="18" iconColor="#FF3366"/>
                        <Label text="%help.wiring.edit.title" styleClass="options-subtitle"/>
                    </HBox>
                    <Label text="%help.wiring.edit.desc1" styleClass="options-label" wrapText="true"/>
                    <Label text="%help.wiring.edit.desc2" styleClass="options-label" wrapText="true"/>
                    <Label text="%help.wiring.edit.desc3" styleClass="options-label" wrapText="true"/>
                    <Label text="%help.wiring.edit.desc4" styleClass="options-label" wrapText="true"/>
                    <Label text="%help.wiring.edit.desc5" styleClass="options-label" wrapText="true"/>
                    
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconLiteral="mdi2f-flash" iconSize="18" iconColor="#FFD700"/>
                        <Label text="%help.wiring.status.title" styleClass="options-subtitle"/>
                    </HBox>
                    <Label text="%help.wiring.status.desc" styleClass="options-label" wrapText="true"/>
                    
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconLiteral="mdi2g-grid" iconSize="18" iconColor="#FFD700"/>
                        <Label text="%help.wiring.grid.title" styleClass="options-subtitle"/>
                    </HBox>
                    <Label text="%help.wiring.grid.desc" styleClass="options-label" wrapText="true"/>
                </VBox>

                <!-- 4. 게이트 도움말 -->
                <VBox fx:id="gateHelpPane" spacing="14" styleClass="options-pane" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="%help.gate.title" styleClass="options-title"/>
                        <FontIcon iconLiteral="mdi2b-book-open-page-variant" iconSize="24" iconColor="#4A90E2"/>
                    </HBox>
                    <Separator styleClass="options-separator"/>
                    <TextField fx:id="gateHelpSearchField" promptText="%help.gate.search_prompt" styleClass="options-textfield"/>
                    <VBox spacing="10" VBox.vgrow="ALWAYS" prefHeight="610">
                        <ListView fx:id="gateHelpListView" minHeight="110" prefHeight="150" styleClass="options-category-list"/>
                        <WebView fx:id="gateHelpWebView" minHeight="420" prefHeight="420"/>
                    </VBox>
                </VBox>
                
                <!-- 5. 단축키 모음 -->
                <VBox fx:id="shortcutPane" spacing="20" styleClass="options-pane" visible="false">
                    <Label text="%help.shortcut.title" styleClass="options-title"/>
                    <Separator styleClass="options-separator"/>
                    
                    <GridPane hgap="20" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" prefWidth="120" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>
                        
                        <Label text="Ctrl + C / V" styleClass="options-value" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label text="%help.shortcut.copy_paste" styleClass="options-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        
                        <Label text="Ctrl + Z / Ctrl + Shift + Z" styleClass="options-value" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label text="%help.shortcut.undo_redo" styleClass="options-label" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        
                        <Label text="Q / E" styleClass="options-value" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label text="%help.shortcut.rotate_10" styleClass="options-label" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        
                        <Label text="Shift + Q / E" styleClass="options-value" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label text="%help.shortcut.rotate_90" styleClass="options-label" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        
                        <Label text="Del / Backspace" styleClass="options-value" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <Label text="%help.shortcut.delete" styleClass="options-label" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        
                        <Label text="Ctrl + A" styleClass="options-value" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <Label text="%help.shortcut.select_all" styleClass="options-label" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                        
                        <Label text="ESC" styleClass="options-value" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <Label text="%help.shortcut.cancel" styleClass="options-label" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                        
                        <Label text="방향키 / 마우스 휠" styleClass="options-value" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <Label text="%help.shortcut.camera" styleClass="options-label" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>
            </StackPane>
        </ScrollPane>
    </center>
    
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="15" styleClass="options-bottom-bar">
            <Button text="%common.close" onAction="#close" styleClass="options-btn-apply"/>
        </HBox>
    </bottom>
</BorderPane>
