<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox spacing="15" prefWidth="500" prefHeight="400" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.logicgate.ui.ModManagerController" styleClass="mod-manager-root">
    <stylesheets>
        <URL value="@mod_manager.css" />
    </stylesheets>
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="%mod_manager.title" styleClass="title-label"/>
    <Label text="%mod_manager.subtitle" styleClass="subtitle-label"/>

    <ListView fx:id="modListView" VBox.vgrow="ALWAYS" styleClass="mod-list"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="%mod_manager.add" onAction="#addMod" styleClass="action-btn, add-btn"/>
        <Button text="%mod_manager.remove" onAction="#removeMod" styleClass="action-btn, remove-btn"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%common.close" onAction="#close" styleClass="action-btn, close-btn"/>
    </HBox>
    
    <Label text="%mod_manager.info" styleClass="info-label"/>
</VBox>
